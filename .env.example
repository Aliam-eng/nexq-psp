# --- Database (PostgreSQL) ---
# Matches docker-compose.yml. For a cloud DB (Neon/Supabase/Railway) paste their URL,
# usually with ?sslmode=require appended.
DATABASE_URL="postgresql://nexq:nexq@localhost:5432/nexq_deposit?schema=public"

# --- Auth ---
# REQUIRED in production (the app refuses to start without a real value).
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"

# --- Initial admin (used by `npm run seed`) ---
# Created on first seed only; change the password later from Settings → Account.
ADMIN_EMAIL="admin@nexq.local"
ADMIN_PASSWORD="changeme"
# Set to "true" to also create the demo client/accounts in production.
# SEED_DEMO="true"

# --- App ---
# Public base URL used to build Rival return/callback URLs
APP_BASE_URL="http://localhost:3000"

# --- Mock MT5 gateway (dev only) ---
MOCK_MT5_PORT="4100"
